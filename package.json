{
  "name": "tsp-template",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "audit": "bun audit",
    "build": "vite build",
    "check": "bun run audit && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.61.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.1.11"
  }
}
